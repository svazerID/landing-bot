---
export const prerender = false;
import HomeLayout from '../layouts/HomeLayout.astro';
import Footer from '../components/Footer.astro';
import ProjectPanel from '../components/ProjectPanel.astro';
import ReadingTile from '../components/ReadingTile.astro';
import { sanityClient } from '../utils/sanity';

let logbookEntries = [];
let projects = [];
let siteSettings = null;

try {
  [logbookEntries, projects, siteSettings] = await Promise.all([
    sanityClient.fetch(`*[_type == "logbookEntry"] | order(publishedAt desc) [0..2]`),
    sanityClient.fetch(`*[_type == "project"] | order(order asc)`),
    sanityClient.fetch(`*[_type == "siteSettings"][0]`)
  ]);
} catch (error) {
  console.error("Failed to fetch data from Sanity:", error);
}

// Override with static data for bot portfolio
projects = [
  {
    title: "Alsya API",
    description: "A single gateway to 135 endpoints across nine categories: AI, tools, search, download, stalker, anime, news, maker and random. Every endpoint can be tested live straight from the browser directory, with docs and Swagger alongside it.",
    slug: { current: "alsya-api" },
    projectUrl: "https://alsya.svazer.eu.cc",
    themeHex: "#0f1a30",
    device: "browser",
    homepageImage: "/projects/alsya.jpg"
  },
  {
    title: "Svazer CDN",
    description: "A file hosting endpoint. Drop a file up to 25 MB, get back a permanent /file/<filename> link, and share it anywhere. Upload by drag & drop from the browser, or from code with a single POST request. Every format is accepted.",
    slug: { current: "svazer-cdn" },
    projectUrl: "https://cdn.svazer.eu.cc",
    themeHex: "#2a0a30",
    device: "browser",
    homepageImage: "/projects/svazer-cdn.jpg"
  },
  {
    title: "Svazer AI",
    description: "Svazer AI is a web chat interface for a multimodal assistant. Upload an image, analyze data, brainstorm, write code, or talk to it with voice, all in one thread.",
    slug: { current: "svazer-ai" },
    projectUrl: "https://ai.svazer.eu.cc",
    themeHex: "#0a1828",
    device: "iphone",
    homepageImage: "/projects/svazer-ai.jpg"
  },
  {
    title: "Media Downloader API",
    description: "A media download API you can call from anything. Send one URL, get back a JSON response with a direct file link, no API key required. Supports YouTube, Spotify, X/Twitter, Facebook, Dailymotion and Vimeo, with full OpenAPI docs and a health endpoint for uptime checks.",
    slug: { current: "media-downloader-api" },
    projectUrl: "https://download.svazer.us.ci",
    themeHex: "#2d1b11",
    device: "browser",
    homepageImage: "/projects/media-downloader-api.jpg"
  },
  {
    title: "Svazer Playlist",
    description: "A Spotify playlist player that actually works without logging in. Paste any public playlist link and every track loads instantly with cover art, artist names and a built-in search. Includes a mini player, queue view and a light/dark theme toggle.",
    slug: { current: "svazer-playlist" },
    projectUrl: "https://spotify-playlist.svazer.us.ci",
    themeHex: "#1c0d22",
    device: "iphone",
    homepageImage: "/projects/svazer-playlist.jpg"
  },
  {
    title: "ZerDonghua",
    description: "A streaming portal dedicated to donghua, Chinese 3D and 2D animation, with Indonesian subtitles. Fresh episodes daily in HD, a multi-server player, release schedule and genre browsing.",
    slug: { current: "zerdonghua" },
    projectUrl: "https://donghua.svazer.us.ci",
    themeHex: "#0e221c",
    device: "browser",
    homepageImage: "/projects/zerdonghua.jpg"
  },
  {
    title: "ZerAnime",
    description: "A free anime streaming site with no sign-up required. Browse by genre, follow the weekly release schedule, save favourites, and pick up right where you left off.",
    slug: { current: "zeranime" },
    projectUrl: "https://anime.svazer.us.ci",
    themeHex: "#2a0a30",
    device: "browser",
    homepageImage: "/projects/zeranime.jpg"
  },
  {
    title: "Zermovie",
    description: "A movie and series streaming site with Indonesian subtitles. Curated collections, genre filters, a release schedule and a installable app, so you can watch on any device without paying a subscription.",
    slug: { current: "zermovie" },
    projectUrl: "https://movie.svazer.us.ci",
    themeHex: "#0a1828",
    device: "browser",
    homepageImage: "/projects/zermovie.jpg"
  },
  {
    title: "ZerDrakor",
    description: "A Korean drama streaming site with Indonesian subtitles. Explore the catalogue by genre or popularity, follow the weekly airing schedule, keep a personal watchlist, and search by title or actor.",
    slug: { current: "zerdrakor" },
    projectUrl: "https://drakor.svazer.us.ci",
    themeHex: "#240a0a",
    device: "browser",
    homepageImage: "/projects/zerdrakor.jpg"
  },
  {
    title: "Svazer Bot Gateway",
    description: "Run a WhatsApp bot without owning a server. Pair your account in under a minute from a dashboard, switch on the plugins you need, and let it keep working 24/7 while you sleep. Ships with 90+ ready-made plugins.",
    slug: { current: "gtwbot" },
    projectUrl: "https://gtwbot.svazer.us.ci",
    themeHex: "#0a1f16",
    device: "browser",
    homepageImage: "/projects/gtwbot.jpg"
  },
  {
    title: "Takina MD",
    description: "A full WhatsApp bot ecosystem with multi-model AI integration, a deep RPG system, a universal downloader and 500+ commands ready to use. Built on an elegant, scalable plugin architecture.",
    slug: { current: "takina" },
    projectUrl: "https://takina.svazer.eu.cc",
    themeHex: "#140f30",
    device: "iphone",
    homepageImage: "/projects/takina.jpg"
  },
  {
    title: "Zerpaste",
    description: "A pastebin that stays out of your way. Drop code or text into a box and get a shareable link back, with syntax highlighting for 19 languages, optional password protection, unlisted mode, and expiry times from 10 minutes up to forever.",
    slug: { current: "zerpaste" },
    projectUrl: "https://zerpaste.svazer.workers.dev",
    themeHex: "#0a0f20",
    device: "iphone",
    homepageImage: "/projects/zerpaste.jpg"
  },
  {
    title: "SvazerPRD",
    description: "Turn a rough idea into something buildable. Describe what you want and get back a structured PRD, a UI prototype, or an application skeleton, ready to hand to a coding agent. Free, no login, with the quota resetting daily.",
    slug: { current: "svazer-prd" },
    projectUrl: "https://prd.svazer.us.ci",
    themeHex: "#0f1030",
    device: "iphone",
    homepageImage: "/projects/svazer-prd.jpg"
  },
  {
    title: "Semantika",
    description: "An interactive hub for learning semantic HTML5 properly. Work through 34 documented elements by category, build a page element by element, run a linter and accessibility audit on your markup, then test yourself with quizzes and a cheatsheet.",
    slug: { current: "semantika" },
    projectUrl: "https://semantika.svazer.us.ci",
    themeHex: "#1a1626",
    device: "iphone",
    homepageImage: "/projects/semantika.jpg"
  }
];

// Derived at build time so the stat tiles cannot drift from the real list.
const projectCount = projects.length;
// Count distinct live hosts, so a project listed twice never inflates the number.
const liveDomainCount = new Set(
  projects.map((p: any) => {
    try {
      return new URL(p.projectUrl).hostname;
    } catch {
      return null;
    }
  }).filter(Boolean)
).size;

const siteTitle = "Svazer The Great | Digital Ecosystem";
const siteDescription = "The digital portfolio of Svazer The Great. Building advanced AI integrations, web applications, and automation ecosystems.";
const bio = "hi, svazer here. welcome to the digital playground of svazer the great. a space dedicated to advanced ai integrations, web applications, and automation engineering. we build complete digital ecosystems, from sophisticated bots to high-performance media platforms.";
---

<HomeLayout title={siteTitle} description={siteDescription} projects={projects}>
  <section class="hero-immersive section-snap" id="top">
    <div class="hero-parallax-wrapper">
      <h1 id="hero-title" class="hero-massive-text">SVAZER THE GREAT</h1>

      <div class="hero-center-cluster">
        <div class="intro-portrait"></div>
        <div class="intro-logo-overlay">
          <svg viewBox="0 0 100 100" class="iah-logo">
            <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="'Geist Mono', monospace" font-size="18" font-weight="bold" fill="currentColor" letter-spacing="-1">SVAZER THE GREAT</text>
          </svg>
        </div>
      </div>

      <p class="hero-copy centered-text" id="profile-bio">
        {bio}
      </p>
    </div>

    <div class="scroll-indicator-wrapper">
      <span class="scroll-indicator-text">SCROLL FOR MORE</span>
      <div class="scroll-indicator">
        <div class="scroll-indicator-line"></div>
      </div>
    </div>
  </section>

  {projects.map((project: any, index: number) => (
    <ProjectPanel project={project} index={index} />
  ))}

  <!-- The Design System (The Engine Room) -->
  <section class="engine-room-section section-snap" id="design-system">
    <div class="engine-room-content">
      <div>
        <h2 class="engine-title">SYSTEM ARCHITECTURE</h2>
        <p class="engine-copy">Powered by Node.js, Astro, & modern AI frameworks. Explore the robust backend architectures, dynamic integrations, and scalable software ecosystems that drive Svazer The Great.</p>
      </div>
      <a href="https://github.com/svazerID" class="button button-massive ds-cta" target="_blank" rel="noreferrer" data-hover>
        Explore <i data-lucide="arrow-right" style="margin-left: 16px; width: 24px; height: 24px;"></i>
      </a>
    </div>
  </section>

  <!-- The Logbook -->
  <section class="logbook-cinematic section-snap" id="logbook">
    <div class="logbook-header-wrapper">
      <h2 class="logbook-huge-title">LOGBOOK</h2>
    </div>
    <div id="logbook-list" class="logbook-list">
      {logbookEntries.map((entry: any) => {
        const date = new Date(entry.publishedAt);
        const dateStr = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
        return (
          <a href={`/logbook/${entry.slug.current}`} class="logbook-entry" data-hover>
            <div class="logbook-date">{dateStr}</div>
            <div class="logbook-content">
              <h3 class="logbook-title-parallax">{entry.title}</h3>
            </div>
          </a>
        );
      })}
    </div>
<div class="logbook-footer" style="margin-top: 4vw; text-align: right;">
      <a href="/logbook" class="button button-massive" data-hover style="padding: 16px 32px; font-size: 1rem;">View Full Logbook →</a>
    </div>
  </section>

  <!-- The Shelf Part 1: Build Metrics & Status -->
  <section class="bento-section section-snap" id="shelf-builds">
    <div class="bento-wrapper">
      <div class="logbook-header-wrapper">
        <h2 class="logbook-huge-title bento-title-parallax">MUSEUM OF MY MESS</h2>
      </div>
      <div class="bento-grid bento-grid-builds">
        <!-- Tile: Clock -->
        <div class="bento-tile bento-clock">
          <div class="bento-kicker">LOCAL TIME</div>
          <div class="geist-wrapper">
            <span id="geist-time" class="geist-time">00:00</span>
            <span id="geist-seconds" class="geist-seconds">00</span>
          </div>
          <div class="clock-location">INDONESIA, ID</div>
        </div>

        <!-- Tile: Reading Tile (SSR from Sanity) -->
        <ReadingTile currentlyReading={siteSettings?.currentlyReading} />

        <!-- Tile: GitHub (Named Area: gh) -->
        <div class="bento-tile bento-github">
          <div class="github-header">
            <div class="bento-kicker">BUILD METRICS</div>
            <div class="gh-counter" id="gh-total-count">... contributions</div>
          </div>
          <div class="github-container">
            <div class="gh-labels-y"><span>Mon</span><span>Wed</span><span>Fri</span></div>
            <div class="github-matrix"></div>
          </div>
          <div class="github-footer">
            <div class="github-meta"><span>github.com/svazerID</span><i data-lucide="github" style="width: 14px;"></i></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Shelf Part 2: Gear & Media -->
  <section class="bento-section section-snap" id="shelf-media">
    <div class="bento-wrapper">
      <div class="logbook-header-wrapper">
        <div class="bento-kicker" style="color: var(--accents-5); letter-spacing: 0.3em; margin-bottom: 16px;">THE GEAR // THE MESS</div>
        <h2 class="logbook-huge-title bento-title-parallax" style="font-size: clamp(2rem, 5vw, 4rem); color: var(--geist-foreground);">COLLECTED FRAGMENTS</h2>
      </div>
      <div class="bento-grid bento-grid-media">
        <!-- Tile: Spotify (Named Area: audio) -->
        <div class="bento-tile bento-audio" style="padding: 0;">
          <iframe src="https://open.spotify.com/embed/playlist/4d0fHu8OIqR1evggIfTZWf?utm_source=generator" style="border-radius:16px; border: none; width: 100%; height: 100%;" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>

        <!-- Tile: Gear (Named Area: shoe) -->
        <div class="bento-tile bento-shoe">
          <div class="bento-kicker">CURRENT GEAR</div>
          <!-- We use absolute public URLs for static assets that we ported -->
          <img src="https://placehold.co/400x400/12121C/6C5CE7?text=Node.js+v22&font=raleway" class="shoe-img" alt="Node.js v22" />
          <div class="shoe-name">NODE.JS V22</div>
        </div>

        <!-- Tile: Athletics (Named Area: athletics) -->
        <div class="bento-tile bento-athletics">
          <div class="bento-kicker">PROJECT STATS</div>
          <div class="athletics-data">
            <div class="ath-row"><span class="ath-label">PROJECTS</span><span class="ath-value">{projectCount}</span></div>
            <div class="ath-row"><span class="ath-label">LIVE DOMAINS</span><span class="ath-value">{liveDomainCount}</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer className="section-snap" variant="massive" />
</HomeLayout>
