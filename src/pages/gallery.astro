---
export const prerender = false;
import MagazineLayout from '../layouts/MagazineLayout.astro';

// Same static list the homepage renders. Kept here because both pages are
// server-rendered and the homepage array is not exported; if you add a project,
// follow "Project data lives in two places" in AGENTS.md.
