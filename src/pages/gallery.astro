---

<MagazineLayout
  title="Gallery"
  path="/gallery"
  description="Every screenshot from the 14 live projects behind Svazer The Great, collected in one wall."
>
  <div class="gallery-page">
    <!-- Clears the fixed Magazine header -->
    <div class="gallery-spacer"></div>

    <header class="gallery-header">
      <h1 class="article-title">THE WALL</h1>
      <p class="gallery-sub">
        {projects.length} LIVE PROJECTS &middot; REAL SCREENSHOTS
      </p>
    </header>

    <section class="gallery-grid" aria-label="Project screenshots">
      {projects.map((project: any) => (
        <figure class="gallery-item" style={`--tint: ${project.themeHex};`}>
          <a
            href={`/projects/${project.slug.current}`}
            class="gallery-shot"
            data-hover
            aria-label={`Open ${project.title} details`}
          >
            <img
              src={project.homepageImage}
              alt={`${project.title} interface`}
              loading="lazy"
              decoding="async"
              width={project.device === 'iphone' ? 430 : 1280}
              height={project.device === 'iphone' ? 932 : 900}
            />
          </a>
          <figcaption class="gallery-caption">
            <div class="gallery-text">
              <span class="gallery-name">{project.title}</span>
              <span class="gallery-meta">
                {project.device === 'iphone' ? 'MOBILE' : 'DESKTOP'}
              </span>
            </div>
            <a
              href={project.projectUrl}
              class="gallery-visit"
              target="_blank"
              rel="noreferrer"
              data-hover
            >
              LIVE &#8599;
            </a>
          </figcaption>
        </figure>
      ))}
    </section>

    <div class="gallery-back">
      <a href="/#top" class="footer-back-studio" data-hover>&larr; Back to Studio</a>
    </div>
  </div>
</MagazineLayout>

<style>
  .gallery-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 5vw 80px;
  }

  /* Matches the logbook listing, which also has to clear the fixed header. */
  .gallery-spacer {
    height: 180px;
    width: 100%;
  }

  .gallery-header {
    margin-bottom: 56px;
  }

  .gallery-sub {
    color: var(--accents-5);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    margin-top: 1rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .gallery-item {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  /* Screenshots come in two shapes: 1280x900 desktop and 430x932 mobile.
   A fixed 4:3 box keeps the grid even, and contain (not cover) means neither
   shape gets cropped. The tint behind it comes from the project's own colour. */
  .gallery-shot {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    padding: 14px;
    border: 1px solid var(--geist-border);
    border-radius: 10px;
    background:
      radial-gradient(120% 100% at 50% 0%, color-mix(in srgb, var(--tint) 70%, #000) 0%, #07070b 75%);
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .gallery-shot:hover {
    border-color: var(--geist-border-hover);
    transform: translateY(-3px);
  }

  .gallery-shot img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
  }

  .gallery-caption {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
  }

  .gallery-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .gallery-name {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .gallery-meta,
  .gallery-visit {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accents-5);
  }

  .gallery-visit {
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .gallery-visit:hover {
    color: var(--geist-border-hover);
  }

  .gallery-back {
    text-align: center;
    margin-top: 64px;
  }

  @media (max-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .gallery-spacer {
      height: 140px;
    }
  }
</style>
